{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/@lottiefiles/creator-plugin-types"
    ]
  },
  "include": ["plugin.ts"]
}
